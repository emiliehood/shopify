{%- comment -%}
  Collection content: Collection product grid with editorial cards
  Editorial blocks are inserted after a chosen product position (on page 1).
  Product tagline comes from the optional metafield product.metafields.custom.tagline.
{%- endcomment -%}

<div class="cc-grid-wrap cc-scope" style="--cc-bg: {{ section.settings.bg }}; --cc-fg: {{ section.settings.fg }}; --cc-cols-d: {{ section.settings.cols_desktop }}; --cc-cols-m: {{ section.settings.cols_mobile }};">
  <div class="cc-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="cc-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- paginate collection.products by section.settings.per_page -%}
      {%- if collection.products.size == 0 -%}
        <p class="cc-empty">No products in this collection yet.</p>
      {%- else -%}
        <ul class="cc-grid" role="list">
          {%- for product in collection.products -%}
            {%- assign position = forloop.index -%}
            {%- liquid
              assign lazy_load = false
              if forloop.index > 4
                assign lazy_load = true
              endif
            -%}
            <li class="cc-grid__item">
              {% render 'cc-product-card',
                product: product,
                show_badge: section.settings.show_badge,
                show_quick_add: section.settings.show_quick_add,
                show_hover_image: section.settings.show_hover_image,
                lazy: lazy_load
              %}
            </li>

            {%- if paginate.current_page == 1 -%}
              {%- for block in section.blocks -%}
                {%- if block.settings.position == position -%}
                  <li class="cc-grid__item cc-grid__item--editorial cc-span-{{ block.settings.span }}" {{ block.shopify_attributes }}>
                    {% render 'cc-editorial-card', block: block %}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} Editorial cards set past the last product still show, at the end {%- endcomment -%}
          {%- if paginate.current_page == 1 -%}
            {%- assign shown = collection.products.size -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.position > shown -%}
                <li class="cc-grid__item cc-grid__item--editorial cc-span-{{ block.settings.span }}" {{ block.shopify_attributes }}>
                  {% render 'cc-editorial-card', block: block %}
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="cc-pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="cc-pill">Previous</a>
            {%- endif -%}
            <span class="cc-pagination__status">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="cc-pill">Next</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% render 'cc-styles' %}

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "class": "cc-section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "cols_desktop", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "cols_mobile", "label": "Columns on mobile", "min": 1, "max": 2, "step": 1, "default": 2 },
    { "type": "checkbox", "id": "show_badge", "label": "Show sale badge", "default": true },
    { "type": "checkbox", "id": "show_hover_image", "label": "Show second image on hover", "default": true },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show quick add button", "default": true },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#1f2a2e" },
    {
      "type": "paragraph",
      "content": "Add Editorial cards to place content between products. Product taglines come from the metafield custom.tagline (single line text)."
    }
  ],
  "blocks": [
    {
      "type": "editorial",
      "name": "Editorial card",
      "settings": [
        { "type": "range", "id": "position", "label": "Show after product #", "min": 1, "max": 48, "step": 1, "default": 2 },
        {
          "type": "select", "id": "span", "label": "Width", "default": "1",
          "options": [ { "value": "1", "label": "1 column" }, { "value": "2", "label": "2 columns" } ]
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Start here." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A quick guide to choosing the right product for you.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select", "id": "style", "label": "Style", "default": "overlay",
          "options": [
            { "value": "overlay", "label": "Text over image" },
            { "value": "stacked", "label": "Image above text" },
            { "value": "solid", "label": "Solid color (no image)" }
          ]
        },
        { "type": "color", "id": "card_bg", "label": "Card color (solid style)", "default": "#1f2a2e" },
        { "type": "color", "id": "card_fg", "label": "Card text color", "default": "#ffffff" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "Product grid" } ]
}
{% endschema %}
