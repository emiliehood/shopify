{%- comment -%}
  Collection content: Collection hero
  H1 + intro copy + optional filter pills linking to related collections.
  Defaults to the collection's own title and description, with optional overrides.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading | default: collection.title
  assign intro = section.settings.intro
  if intro == blank
    assign intro = collection.description
  endif
-%}

<div class="cc-hero cc-scope" style="--cc-bg: {{ section.settings.bg }}; --cc-fg: {{ section.settings.fg }};">
  <div class="cc-container cc-hero__inner cc-hero__inner--{{ section.settings.align }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="cc-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="cc-hero__title">{{ heading }}</h1>
    {%- if intro != blank -%}
      <div class="cc-hero__intro cc-rte">{{ intro }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <nav class="cc-pills" aria-label="Shop by category">
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_active = false
            if block.settings.link != blank and request.path == block.settings.link
              assign is_active = true
            endif
          -%}
          <a href="{{ block.settings.link | default: '#' }}"
             class="cc-pill{% if is_active %} is-active{% endif %}"
             {% if is_active %}aria-current="page"{% endif %}
             {{ block.shopify_attributes }}>
            {{- block.settings.label -}}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- if section.settings.show_count -%}
      <p class="cc-hero__count">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</p>
    {%- endif -%}
  </div>
</div>

{% render 'cc-styles' %}

{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "class": "cc-section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (small text above title)" },
    { "type": "text", "id": "heading", "label": "Title override", "info": "Leave blank to use the collection title." },
    { "type": "richtext", "id": "intro", "label": "Intro override", "info": "Leave blank to use the collection description." },
    {
      "type": "select", "id": "align", "label": "Alignment", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ]
    },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#1f2a2e" }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Filter pill",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "All" },
        { "type": "url", "id": "link", "label": "Link", "info": "Usually another collection." }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [ { "name": "Collection hero" } ]
}
{% endschema %}
