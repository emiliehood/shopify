{%- comment -%}
  Collection content: FAQ accordion with optional FAQPage structured data.
  Turn off the schema toggle if the theme already outputs FAQPage schema on this page.
{%- endcomment -%}
<div class="cc-faq cc-scope" style="--cc-bg: {{ section.settings.bg }}; --cc-fg: {{ section.settings.fg }};">
  <div class="cc-container cc-faq__inner">
    {%- if section.settings.heading != blank -%}<h2 class="cc-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="cc-faq__list">
      {%- for block in section.blocks -%}
        <details class="cc-faq__item" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="cc-faq__q">
            <span>{{ block.settings.question }}</span>
            <span class="cc-faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="cc-faq__a cc-rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% render 'cc-styles' %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "cc-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question by default", "default": false },
    { "type": "checkbox", "id": "schema", "label": "Add FAQ schema for Google", "default": true, "info": "Turn off if your theme already adds FAQPage schema to this page." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f4f6f8" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#1f2a2e" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Which product should I start with?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Start with our bestseller. It covers what most customers need.</p>" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [ { "name": "FAQ", "blocks": [ { "type": "question" } ] } ]
}
{% endschema %}
