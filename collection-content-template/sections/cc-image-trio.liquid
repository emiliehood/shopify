{%- comment -%} Collection content: Three images + heading + text. Works on any template. {%- endcomment -%}
<div class="cc-trio cc-scope" style="--cc-bg: {{ section.settings.bg }}; --cc-fg: {{ section.settings.fg }};">
  <div class="cc-container">
    <div class="cc-trio__images">
      {%- for block in section.blocks -%}
        <figure class="cc-trio__img-wrap" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 750px) 33vw, 100vw',
              widths: '400, 600, 800, 1000',
              class: 'cc-trio__img',
              alt: block.settings.image.alt
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'cc-trio__img cc-placeholder' }}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <figcaption class="cc-trio__caption">{{ block.settings.caption }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="cc-trio__copy cc-trio__copy--{{ section.settings.align }}">
        {%- if section.settings.heading != blank -%}<h2 class="cc-h2">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="cc-rte cc-lede">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="cc-btn">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% render 'cc-styles' %}

{% schema %}
{
  "name": "Image trio + text",
  "tag": "section",
  "class": "cc-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for everyday use." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Thoughtfully designed products that fit into the way you already live.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "link", "label": "Button link" },
    {
      "type": "select", "id": "align", "label": "Text alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ]
    },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f4f6f8" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#1f2a2e" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption (optional)" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [ { "name": "Image trio + text", "blocks": [ { "type": "image" }, { "type": "image" }, { "type": "image" } ] } ]
}
{% endschema %}
