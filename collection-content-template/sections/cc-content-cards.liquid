{%- comment -%}
  Collection content: Row of content cards (guides, routines, journal posts).
  Add Card blocks manually, or pick a blog to show its latest articles automatically.
{%- endcomment -%}
<div class="cc-cards cc-scope" style="--cc-bg: {{ section.settings.bg }}; --cc-fg: {{ section.settings.fg }};">
  <div class="cc-container">
    <div class="cc-cards__head">
      {%- if section.settings.heading != blank -%}<h2 class="cc-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="cc-link">{{ section.settings.link_label }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>

    <ul class="cc-cards__row" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <li class="cc-cards__item" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="cc-cards__card">
              <div class="cc-cards__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 75vw', widths: '400, 600, 800', class: 'cc-cards__img', alt: block.settings.image.alt | default: block.settings.title }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'cc-cards__img cc-placeholder' }}
                {%- endif -%}
              </div>
              {%- if block.settings.tag != blank -%}<p class="cc-eyebrow">{{ block.settings.tag }}</p>{%- endif -%}
              <h3 class="cc-cards__title">{{ block.settings.title }}</h3>
            </a>
          </li>
        {%- endfor -%}
      {%- elsif section.settings.blog != blank -%}
        {%- for article in section.settings.blog.articles limit: section.settings.article_count -%}
          <li class="cc-cards__item">
            <a href="{{ article.url }}" class="cc-cards__card">
              <div class="cc-cards__media">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 75vw', widths: '400, 600, 800', class: 'cc-cards__img', alt: article.image.alt | default: article.title }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'cc-cards__img cc-placeholder' }}
                {%- endif -%}
              </div>
              {%- if article.tags.size > 0 -%}<p class="cc-eyebrow">{{ article.tags.first }}</p>{%- endif -%}
              <h3 class="cc-cards__title">{{ article.title }}</h3>
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% render 'cc-styles' %}

{% schema %}
{
  "name": "Content cards",
  "tag": "section",
  "class": "cc-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Guides and how-tos" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the journal" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "header", "content": "Automatic mode" },
    { "type": "paragraph", "content": "If you add no Card blocks, the latest articles from this blog show instead." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "article_count", "label": "Articles to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#1f2a2e" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Guide" },
        { "type": "text", "id": "title", "label": "Title", "default": "Getting started guide" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "Content cards" } ]
}
{% endschema %}
